              },
              {
                "weight": 1,
                "set_property": {
                  "minecraft:sound_variant": "moody"
                }
              }
            ]
          },
          {
            "filters": {
              "test": "int_property",
              "domain": "litius:mutacion",
              "operator": "==",
              "value": 1
            },
            "add": {
              "component_groups": [
                "litius:mejorado"
