              },
              {
                "weight": 1,
                "set_property": {
                  "litius:pelaje": 1
                }
              },
              {
                "weight": 1,
                "set_property": {
                  "litius:pelaje": 2
                }
              }
            ]
          },
          {
            "queue_command": {
              "command": [
                "summon cow ~2 ~ ~1 0 0 litius:vaca_manada",
                "summon cow ~-2 ~ ~1 0 0 litius:vaca_manada",
                "summon cow ~0 ~ ~-2 0 0 litius:vaca_manada"
              ]
            }
          }
        ]
