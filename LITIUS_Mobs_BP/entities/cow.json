            "add": {
              "component_groups": [
                "minecraft:cow_adult"
              ]
            }
          },
          {
            "filters": {
              "test": "int_property",
              "domain": "litius:mutacion",
              "operator": "==",
              "value": 1
            },
            "add": {
              "component_groups": [
                "litius:mejorado"
              ]
            }
          }
