        "queue_command": {
          "command": [
            "event entity @e[type=cow,r=16] litius:enfurecer"
          ]
        }
      },
      "litius:enfurecer": {
        "sequence": [
          {
            "filters": {
              "test": "int_property",
              "domain": "litius:mutacion",
              "value": 1
            },
            "add": {
              "component_groups": [
                "litius:furia"
              ]
            }
          }
        ]
      },
      "litius:calmar": {
        "remove": {
          "component_groups": [
            "litius:furia"
          ]
        }
      },
      "litius:vaca_manada": {
        "sequence": [
          {
            "set_property": {
              "litius:tirada": true
            }
          },
          {
            "trigger": "minecraft:spawn_adult"
          }
        ]
