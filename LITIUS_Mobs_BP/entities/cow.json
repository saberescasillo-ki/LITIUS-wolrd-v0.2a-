          {
            "filters": {
              "test": "int_property",
              "domain": "litius:mutacion",
              "operator": "==",
              "value": 1
            },
            "add": {
              "component_groups": [
                "litius:mejorado"
              ]
            }
          },
          {
            "filters": {
              "test": "bool_property",
              "domain": "litius:tirada",
              "operator": "==",
              "value": false
            },
            "randomize": [
              {
                "weight": 75,
                "set_property": {
                  "litius:tirada": true
                }
              },
              {
                "weight": 25,
                "trigger": "litius:mutar"
