{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "litius:creeper_musgoso",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "litius:explotando": {
        "minecraft:movement": {
          "value": 0.0
        },
        "minecraft:explode": {
          "fuse_length": 1.5,
          "fuse_lit": true,
          "power": 2,
          "causes_fire": false,
          "destroy_affected_by_griefing": true
        },
        "minecraft:timer": {
          "looping": false,
          "time": 1.35,
          "time_down_event": {
            "event": "litius:esporas",
            "target": "self"
          }
        }
      },
      "litius:explotando_cargado": {
        "minecraft:movement": {
          "value": 0.0
        },
        "minecraft:explode": {
          "fuse_length": 1.5,
          "fuse_lit": true,
          "power": 4,
          "causes_fire": false,
          "destroy_affected_by_griefing": true
        },
        "minecraft:timer": {
          "looping": false,
          "time": 1.35,
          "time_down_event": {
            "event": "litius:esporas",
            "target": "self"
          }
        }
      },
      "litius:mov_normal": {
        "minecraft:movement": {
          "value": 0.2
        }
      },
      "litius:cargado": {
        "minecraft:is_charged": {}
      }
    },
    "components": {
      "minecraft:is_hidden_when_invisible": {},
      "minecraft:type_family": {
        "family": [
          "creeper",
          "monster",
          "mob"
        ]
      },
      "minecraft:collision_box": {
        "width": 0.6,
        "height": 1.7
      },
      "minecraft:health": {
        "value": 22,
        "max": 22
      },
      "minecraft:movement": {
        "value": 0.2
      },
      "minecraft:follow_range": {
        "value": 16,
        "max": 16
      },
      "minecraft:navigation.walk": {
        "can_path_over_water": false,
        "avoid_water": true
      },
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:can_climb": {},
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:nameable": {},
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "filters": {
              "test": "in_lava",
              "subject": "self",
              "operator": "==",
              "value": true
            },
            "cause": "lava",
            "damage_per_tick": 4
          }
        ]
      },
      "minecraft:despawn": {
        "despawn_from_distance": {}
      },
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:behavior.float": {
        "priority": 0
      },
      "minecraft:behavior.hurt_by_target": {
        "priority": 1
      },
      "minecraft:behavior.random_stroll": {
        "priority": 7,
        "speed_multiplier": 1.0
      },
      "minecraft:behavior.look_at_player": {
        "priority": 8,
        "look_distance": 8,
        "probability": 0.02
      },
      "minecraft:behavior.random_look_around": {
        "priority": 9
      },
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0
      },
      "minecraft:loot": {
        "table": "loot_tables/entities/creeper.json"
      },
      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player ? 5 : 0"
      },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 1,
        "must_see": true,
        "reselect_targets": true,
        "entity_types": [
          {
            "filters": {
              "test": "is_family",
              "subject": "other",
              "value": "player"
            },
            "max_dist": 16
          }
        ]
      },
      "minecraft:behavior.melee_attack": {
        "priority": 4,
        "speed_multiplier": 1.25,
        "track_target": false
      },
      "minecraft:attack": {
        "damage": 0
      },
      "minecraft:target_nearby_sensor": {
        "inside_range": 2.5,
        "outside_range": 6.0,
        "must_see": true,
        "on_inside_range": {
          "event": "litius:encender",
          "target": "self"
        },
        "on_outside_range": {
          "event": "litius:apagar",
          "target": "self"
        },
        "on_vision_lost_inside_range": {
          "event": "litius:apagar",
          "target": "self"
        }
      }
    },
    "events": {
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": [
            "litius:mov_normal"
          ]
        }
      },
      "litius:encender": {
        "sequence": [
          {
            "remove": {
              "component_groups": [
                "litius:mov_normal"
              ]
            }
          },
          {
            "filters": {
              "test": "has_component",
              "operator": "!=",
              "value": "minecraft:is_charged"
            },
            "add": {
              "component_groups": [
                "litius:explotando"
              ]
            }
          },
          {
            "filters": {
              "test": "has_component",
              "value": "minecraft:is_charged"
            },
            "add": {
              "component_groups": [
                "litius:explotando_cargado"
              ]
            }
          }
        ]
      },
      "litius:apagar": {
        "sequence": [
          {
            "remove": {
              "component_groups": [
                "litius:explotando",
                "litius:explotando_cargado"
              ]
            }
          },
          {
            "add": {
              "component_groups": [
                "litius:mov_normal"
              ]
            }
          }
        ]
      },
      "litius:esporas": {
        "queue_command": {
          "command": [
            "particle litius:esporas ~ ~1 ~",
            "playsound mob.puffer.blow_up @a[r=16] ~ ~ ~",
            "effect @e[r=5,family=!creeper] poison 6 0",
            "effect @a[r=5] nausea 8 0"
          ]
        }
      },
      "minecraft:become_charged": {
        "add": {
          "component_groups": [
            "litius:cargado"
          ]
        }
      }
    }
  }
}
