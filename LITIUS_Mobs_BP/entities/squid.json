{
  "format_version": "1.26.20",
  "minecraft:entity": {
    "description": {
      "identifier": "minecraft:squid",
      "is_summonable": true,
      "is_spawnable": true,
      "spawn_category": "water_creature",
      "properties": {
        "litius:mutacion": {
          "type": "int",
          "range": [
            0,
            2
          ],
          "default": 0,
          "client_sync": true
        },
        "litius:tirada": {
          "type": "bool",
          "default": false,
          "client_sync": false
        }
      }
    },
    "components": {
      "minecraft:balloonable": {
        "mass": 0.5
      },
      "minecraft:behavior.squid_dive": {
        "priority": 2
      },
      "minecraft:behavior.squid_flee": {
        "priority": 2
      },
      "minecraft:behavior.squid_idle": {
        "priority": 2
      },
      "minecraft:behavior.squid_move_away_from_ground": {
        "priority": 1
      },
      "minecraft:behavior.squid_out_of_water": {
        "priority": 2
      },
      "minecraft:breathable": {
        "breathes_air": false,
        "breathes_water": true,
        "suffocate_time": 0,
        "total_supply": 15
      },
      "minecraft:can_climb": {},
      "minecraft:collision_box": {
        "height": 0.8,
        "width": 0.8
      },
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:despawn": {
        "despawn_from_distance": {}
      },
      "minecraft:experience_reward": {
        "on_death": "!query.is_baby && query.last_hit_by_player ? Math.Random(1,3) : 0"
      },
      "minecraft:health": {
        "max": 10,
        "value": 10
      },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "cause": "lava",
            "damage_per_tick": 4,
            "filters": {
              "subject": "self",
              "test": "in_lava"
            }
          }
        ]
      },
      "minecraft:is_hidden_when_invisible": {},
      "minecraft:jump.static": {},
      "minecraft:leashable": {},
      "minecraft:loot": {
        "table": "loot_tables/entities/squid.json"
      },
      "minecraft:movement": {
        "value": 0.2
      },
      "minecraft:movement.basic": {},
      "minecraft:nameable": {},
      "minecraft:navigation.walk": {
        "can_path_over_water": true,
        "can_sink": false
      },
      "minecraft:offspring": {
        "offspring_pairs": {
          "minecraft:squid": "minecraft:squid"
        }
      },
      "minecraft:physics": {},
      "minecraft:pushable_by_entity": {},
      "minecraft:pushable_by_block": {},
      "minecraft:spawn_egg_interaction": {},
      "minecraft:type_family": {
        "family": [
          "aquatic",
          "squid",
          "mob"
        ]
      }
    },
    "component_groups": {
      "minecraft:squid_adult": {
        "minecraft:leashable_to": {},
        "minecraft:collision_box": {
          "height": 0.8,
          "width": 0.8
        }
      },
      "minecraft:squid_baby": {
        "minecraft:is_baby": {},
        "minecraft:ageable": {
          "duration": 1200,
          "pause_growth_items": [
            "golden_dandelion"
          ],
          "reset_growth_items": [
            "golden_dandelion"
          ],
          "grow_up": {
            "event": "minecraft:ageable_grow_up",
            "target": "self"
          }
        },
        "minecraft:scale": {
          "value": 0.5
        },
        "minecraft:collision_box": {
          "height": 1,
          "width": 1
        }
      },
      "litius:mejorado_vida": {
        "minecraft:health": {
          "value": 20,
          "max": 20
        }
      },
      "litius:mejorado": {
        "minecraft:scale": {
          "value": 2.053
        },
        "minecraft:collision_box": {
          "width": 1.95,
          "height": 1.95
        },
        "minecraft:movement": {
          "value": 0.4
        },
        "minecraft:underwater_movement": {
          "value": 0.3
        },
        "minecraft:navigation.walk": {
          "can_swim": true,
          "can_walk": false,
          "can_sink": false,
          "avoid_water": false
        },
        "minecraft:attack": {
          "damage": 4,
          "effect_name": "blindness",
          "effect_duration": 5
        },
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 1,
          "must_see": true,
          "within_radius": 24,
          "entity_types": [
            {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "player"
              },
              "max_dist": 24
            }
          ]
        },
        "minecraft:behavior.melee_box_attack": {
          "priority": 2,
          "speed_multiplier": 1.5,
          "track_target": true
        },
        "minecraft:mob_effect": {
          "effect_range": 1.6,
          "mob_effect": "blindness",
          "effect_time": 5,
          "cooldown_time": 4,
          "entity_filter": {
            "test": "is_family",
            "subject": "other",
            "value": "player"
          }
        },
        "minecraft:area_attack": {
          "damage_range": 0.5,
          "damage_per_tick": 3,
          "damage_cooldown": 1.0,
          "cause": "entity_attack",
          "entity_filter": {
            "test": "is_family",
            "subject": "other",
            "value": "player"
          }
        }
      }
    },
    "events": {
      "minecraft:entity_born": {
        "sequence": [
          {
            "add": {
              "component_groups": [
                "minecraft:squid_baby"
              ]
            }
          },
          {
            "filters": {
              "test": "int_property",
              "domain": "litius:mutacion",
              "operator": "==",
              "value": 1
            },
            "add": {
              "component_groups": [
                "litius:mejorado"
              ]
            }
          }
        ]
      },
      "minecraft:entity_spawned": {
        "randomize": [
          {
            "add": {
              "component_groups": [
                "minecraft:squid_adult"
              ]
            },
            "weight": 95,
            "trigger": "minecraft:squid_adult_litius"
          },
          {
            "trigger": "minecraft:entity_born",
            "weight": 5
          }
        ]
      },
      "minecraft:ageable_grow_up": {
        "sequence": [
          {
            "remove": {
              "component_groups": [
                "minecraft:squid_baby"
              ]
            },
            "add": {
              "component_groups": [
                "minecraft:squid_adult"
              ]
            }
          },
          {
            "filters": {
              "test": "int_property",
              "domain": "litius:mutacion",
              "operator": "==",
              "value": 1
            },
            "add": {
              "component_groups": [
                "litius:mejorado"
              ]
            }
          }
        ]
      },
      "litius:mutar": {
        "sequence": [
          {
            "set_property": {
              "litius:mutacion": 1,
              "litius:tirada": true
            }
          },
          {
            "add": {
              "component_groups": [
                "litius:mejorado_vida",
                "litius:mejorado"
              ]
            }
          }
        ]
      },
      "minecraft:squid_adult_litius": {
        "sequence": [
          {
            "add": {
              "component_groups": [
                "minecraft:squid_adult"
              ]
            }
          },
          {
            "filters": {
              "test": "bool_property",
              "domain": "litius:tirada",
              "operator": "==",
              "value": false
            },
            "randomize": [
              {
                "weight": 75,
                "set_property": {
                  "litius:tirada": true
                }
              },
              {
                "weight": 25,
                "trigger": "litius:mutar"
              }
            ]
          }
        ]
      }
    }
  }
}
