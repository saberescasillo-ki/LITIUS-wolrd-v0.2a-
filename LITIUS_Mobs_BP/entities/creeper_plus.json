{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "litius:creeper_plus",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false,
      "properties": {
        "litius:countdown": {
          "type": "bool",
          "default": false,
          "client_sync": false
        }
      }
    },

    "component_groups": {
      "litius:countdown": {
        "minecraft:timer": {
          "looping": false,
          "time": [3.0, 5.5],
          "randomInterval": true,
          "time_down_event": { "event": "litius:ignite", "target": "self" }
        }
      },

      "litius:exploding": {
        "minecraft:movement": { "value": 0.0 },
        "minecraft:explode": {
          "fuse_length": 1.5,
          "fuse_lit": true,
          "power": 5,
          "causes_fire": false,
          "destroy_affected_by_griefing": true
        }
      },

      "litius:charged_exploding": {
        "minecraft:movement": { "value": 0.0 },
        "minecraft:explode": {
          "fuse_length": 1.5,
          "fuse_lit": true,
          "power": 9,
          "causes_fire": false,
          "destroy_affected_by_griefing": true
        }
      },

      "litius:charged": {
        "minecraft:is_charged": {}
      }
    },

    "components": {
      "minecraft:is_hidden_when_invisible": {},
      "minecraft:type_family": { "family": ["creeper", "monster", "mob"] },
      "minecraft:collision_box": { "width": 0.6, "height": 1.95 },
      "minecraft:health": { "value": 24, "max": 24 },
      "minecraft:movement": { "value": 0.21 },
      "minecraft:follow_range": { "value": 20, "max": 20 },
      "minecraft:attack": { "damage": 4 },
      "minecraft:navigation.walk": { "can_path_over_water": false, "avoid_water": true },
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:can_climb": {},
      "minecraft:physics": {},
      "minecraft:pushable": { "is_pushable": true, "is_pushable_by_piston": true },
      "minecraft:nameable": {},
      "minecraft:breathable": { "total_supply": 15, "suffocate_time": 0 },
      "minecraft:loot": { "table": "loot_tables/entities/creeper.json" },
      "minecraft:experience_reward": { "on_death": "query.last_hit_by_player ? 5 : 0" },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "filters": { "test": "in_lava", "subject": "self", "operator": "==", "value": true },
            "cause": "lava",
            "damage_per_tick": 4
          }
        ]
      },
      "minecraft:despawn": { "despawn_from_distance": {} },
      "minecraft:conditional_bandwidth_optimization": {},

      "minecraft:behavior.float": { "priority": 0 },
      "minecraft:behavior.avoid_mob_type": {
        "priority": 1,
        "entity_types": [
          {
            "filters": {
              "any_of": [
                { "test": "is_family", "subject": "other", "value": "ocelot" },
                { "test": "is_family", "subject": "other", "value": "cat" }
              ]
            },
            "max_dist": 6,
            "walk_speed_multiplier": 1,
            "sprint_speed_multiplier": 1.2
          }
        ]
      },
      "minecraft:behavior.delayed_attack": {
        "priority": 3,
        "attack_duration": 0.8,
        "hit_delay_pct": 0.55,
        "reach_multiplier": 1.6,
        "speed_multiplier": 1.25,
        "track_target": false,
        "require_complete_path": false
      },
      "minecraft:behavior.random_stroll": { "priority": 5, "speed_multiplier": 1 },
      "minecraft:behavior.look_at_player": { "priority": 6, "look_distance": 8 },
      "minecraft:behavior.random_look_around": { "priority": 6 },
      "minecraft:behavior.hurt_by_target": { "priority": 2 },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 1,
        "must_see": true,
        "must_see_forget_duration": 3.0,
        "reselect_targets": true,
        "entity_types": [
          {
            "filters": { "test": "is_family", "subject": "other", "value": "player" },
            "max_dist": 16
          }
        ]
      },

      "minecraft:environment_sensor": {
        "triggers": [
          {
            "filters": {
              "all_of": [
                { "test": "has_target", "subject": "self", "value": true },
                { "test": "target_distance", "subject": "self", "operator": "<=", "value": 4 },
                { "test": "bool_property", "domain": "litius:countdown", "operator": "==", "value": false }
              ]
            },
            "event": "litius:begin_countdown"
          },
          {
            "filters": {
              "all_of": [
                { "test": "bool_property", "domain": "litius:countdown", "operator": "==", "value": true },
                {
                  "any_of": [
                    { "test": "has_target", "subject": "self", "value": false },
                    { "test": "target_distance", "subject": "self", "operator": ">", "value": 9 }
                  ]
                }
              ]
            },
            "event": "litius:calm_down"
          }
        ]
      },

      "minecraft:interact": {
        "interactions": {
          "on_interact": {
            "filters": {
              "all_of": [
                { "test": "is_family", "subject": "other", "value": "player" },
                { "test": "has_equipment", "domain": "hand", "subject": "other", "value": "flint_and_steel" },
                { "test": "has_component", "operator": "!=", "value": "minecraft:explode" }
              ]
            },
            "event": "litius:ignite",
            "target": "self"
          },
          "hurt_item": 1,
          "swing": true,
          "play_sounds": "ignite",
          "interact_text": "action.interact.creeper"
        }
      }
    },

    "events": {
      "litius:begin_countdown": {
        "sequence": [
          { "add": { "component_groups": ["litius:countdown"] } },
          { "set_property": { "litius:countdown": true } }
        ]
      },

      "litius:calm_down": {
        "sequence": [
          { "remove": { "component_groups": ["litius:countdown", "litius:exploding", "litius:charged_exploding"] } },
          { "set_property": { "litius:countdown": false } }
        ]
      },

      "litius:ignite": {
        "sequence": [
          { "remove": { "component_groups": ["litius:countdown"] } },
          {
            "filters": { "test": "has_component", "operator": "!=", "value": "minecraft:is_charged" },
            "add": { "component_groups": ["litius:exploding"] }
          },
          {
            "filters": { "test": "has_component", "value": "minecraft:is_charged" },
            "add": { "component_groups": ["litius:charged_exploding"] }
          }
        ]
      },

      "minecraft:become_charged": {
        "add": { "component_groups": ["litius:charged"] }
      }
    }
  }
}
