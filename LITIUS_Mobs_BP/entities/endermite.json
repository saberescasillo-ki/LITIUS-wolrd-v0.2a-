{
  "format_version": "1.26.50",
  "minecraft:entity": {
    "description": {
      "identifier": "minecraft:endermite",
      "is_experimental": false,
      "is_summonable": true,
      "is_spawnable": true,
      "spawn_category": "monster",
      "properties": {
        "litius:mutacion": {
          "type": "int",
          "range": [
            0,
            2
          ],
          "default": 0,
          "client_sync": false
        },
        "litius:tirada": {
          "type": "bool",
          "default": false,
          "client_sync": false
        }
      }
    },
    "components": {
      "minecraft:attack": {
        "damage": 2
      },
      "minecraft:behavior.float": {
        "priority": 0
      },
      "minecraft:behavior.melee_box_attack": {
        "track_target": true,
        "priority": 3
      },
      "minecraft:behavior.nearest_attackable_target": {
        "must_see": true,
        "within_radius": 21,
        "entity_types": [
          {
            "filters": {
              "AND": [
                {
                  "OR": [
                    {
                      "test": "is_family",
                      "subject": 1,
                      "operator": 0,
                      "value": "player"
                    },
                    {
                      "test": "is_family",
                      "subject": 1,
                      "operator": 0,
                      "value": "enderman"
                    }
                  ]
                }
              ]
            },
            "max_dist": 21
          }
        ],
        "priority": 5
      },
      "minecraft:behavior.random_stroll": {
        "priority": 6,
        "speed_multiplier": 1
      },
      "minecraft:block_climber": {},
      "minecraft:breathable": {
        "suffocate_time": 0,
        "total_supply": 15
      },
      "minecraft:can_climb": {},
      "minecraft:collision_box": {
        "height": 0.3,
        "width": 0.4
      },
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:despawn": {
        "despawn_from_distance": {}
      },
      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player ? 3 : 0"
      },
      "minecraft:health": {
        "max": 8,
        "value": 8
      },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "cause": "lava",
            "damage_per_tick": 4,
            "filters": {
              "operator": "==",
              "test": "in_lava",
              "subject": "self",
              "value": true
            }
          }
        ]
      },
      "minecraft:is_hidden_when_invisible": {},
      "minecraft:jump.static": {},
      "minecraft:movement": {
        "value": 0.25
      },
      "minecraft:movement.basic": {},
      "minecraft:nameable": {},
      "minecraft:navigation.walk": {
        "can_path_over_water": true,
        "using_door_annotation": true
      },
      "minecraft:physics": {},
      "minecraft:pushable_by_entity": {},
      "minecraft:pushable_by_block": {},
      "minecraft:can_stand_on_powder_snow": {},
      "minecraft:type_family": {
        "family": [
          "endermite",
          "arthropod",
          "monster",
          "mob"
        ]
      },
      "minecraft:follow_range": {
        "value": 21,
        "max": 21
      }
    },
    "events": {
      "litius:mutar": {
        "sequence": [
          {
            "set_property": {
              "litius:mutacion": 1,
              "litius:tirada": true
            }
          },
          {
            "add": {
              "component_groups": [
                "litius:mejorado_vida",
                "litius:mejorado"
              ]
            }
          }
        ]
      },
      "minecraft:entity_spawned": {
        "sequence": [
          {
            "filters": {
              "test": "bool_property",
              "domain": "litius:tirada",
              "operator": "==",
              "value": false
            },
            "randomize": [
              {
                "weight": 75,
                "set_property": {
                  "litius:tirada": true
                }
              },
              {
                "weight": 25,
                "trigger": "litius:mutar"
              }
            ]
          }
        ]
      }
    },
    "component_groups": {
      "litius:mejorado_vida": {
        "minecraft:health": {
          "value": 12,
          "max": 12
        }
      },
      "litius:mejorado": {
        "minecraft:scale": {
          "value": 2.667
        },
        "minecraft:collision_box": {
          "width": 0.8,
          "height": 0.6
        },
        "minecraft:attack": {
          "damage": 3,
          "effect_name": "slowness",
          "effect_duration": 3
        },
        "minecraft:knockback_resistance": {
          "value": 0.5
        }
      }
    }
  }
}
