{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.litius.caballo_wither": {
      "part_visibility": [
        {
          "Saddle": false
        },
        {
          "Bit*": false
        },
        {
          "Bridle": false
        },
        {
          "Reins*": false
        },
        {
          "Bag*": false
        },
        {
          "MuleEar*": false
        }
      ],
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.skeleton",
        "Texture.markings_none",
        "Texture.armor_none"
      ]
    },
    "controller.render.litius.caballo_esqueleto": {
      "part_visibility": [
        {
          "Saddle": false
        },
        {
          "Bit*": false
        },
        {
          "Bridle": false
        },
        {
          "Reins*": false
        },
        {
          "Bag*": false
        },
        {
          "MuleEar*": false
        }
      ],
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.skeleton",
        "Texture.markings_none",
        "Texture.armor_none"
      ]
    },
    "controller.render.litius.caballo_zombie": {
      "part_visibility": [
        {
          "Saddle": false
        },
        {
          "Bit*": false
        },
        {
          "Bridle": false
        },
        {
          "Reins*": false
        },
        {
          "Bag*": false
        },
        {
          "MuleEar*": false
        }
      ],
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.zombie",
        "Texture.markings_none",
        "Texture.armor_none"
      ]
    },
    "controller.render.litius.zombie": {
      "geometry": "query.is_baby ? Geometry.baby : Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "query.is_baby ? Texture.baby : (query.property('litius:mutacion') == 2 ? Texture.escalador : Texture.default)"
      ]
    },
    "controller.render.litius.skeleton": {
      "geometry": "Array.geos[query.property('litius:mutacion') == 2]",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.texs[query.property('litius:mutacion') == 2]"
      ],
      "arrays": {
        "geometries": {
          "Array.geos": [
            "Geometry.default",
            "Geometry.cueva"
          ]
        },
        "textures": {
          "Array.texs": [
            "Texture.default",
            "Texture.cueva"
          ]
        }
      }
    },
    "controller.render.litius.enderman": {
      "arrays": {
        "materials": {
          "Array.materials": [
            "Material.default",
            "Material.invisible"
          ]
        },
        "geometries": {
          "Array.geos": [
            "Geometry.default",
            "Geometry.mejorado"
          ]
        },
        "textures": {
          "Array.texs": [
            "Texture.default",
            "Texture.mejorado"
          ]
        }
      },
      "geometry": "Array.geos[query.property('litius:mutacion') == 1]",
      "materials": [
        {
          "*": "Array.materials[query.is_invisible]"
        }
      ],
      "textures": [
        "Array.texs[query.property('litius:mutacion') == 1]"
      ]
    },
    "controller.render.litius.base": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ]
    },
    "controller.render.litius.caballo_propio": {
      "part_visibility": [
        {
          "Saddle": false
        },
        {
          "Bit*": false
        },
        {
          "Bridle": false
        },
        {
          "Reins*": false
        },
        {
          "Bag*": false
        },
        {
          "MuleEar*": false
        }
      ],
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ]
    },
    "controller.render.litius.stray": {
      "rebuild_animation_matrices": true,
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "query.property('litius:mutacion') == 1 ? Texture.mutado : Texture.default"
      ]
    },
    "controller.render.litius.toro": {
      "arrays": {
        "textures": {
          "Array.toro": [
            "Texture.toro_1",
            "Texture.toro_2",
            "Texture.toro_6",
            "Texture.toro_8",
            "Texture.toro_1",
            "Texture.toro_2",
            "Texture.toro_5",
            "Texture.toro_6",
            "Texture.toro_5"
          ]
        }
      },
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.toro[v.index * 3 + (query.has_property('litius:pelaje') ? query.property('litius:pelaje') : 0)]"
      ]
    }
  }
}
