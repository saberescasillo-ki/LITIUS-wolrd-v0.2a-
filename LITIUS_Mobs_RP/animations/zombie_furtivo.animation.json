{
  "format_version": "1.8.0",
  "animations": {
    "animation.litius.zombie_furtivo.mirar": {
      "loop": true,
      "bones": {
        "head": {
          "rotation": ["q.target_x_rotation - v.lean * 0.85", "q.target_y_rotation", "-v.side * 0.5"]
        }
      }
    },

    "animation.litius.zombie_furtivo.piernas": {
      "loop": true,
      "bones": {
        "rightLeg": { "rotation": ["v.tcos * 1.2", 0, 0] },
        "leftLeg": { "rotation": ["-v.tcos * 1.2", 0, 0] }
      }
    },

    "animation.litius.zombie_furtivo.inclinacion": {
      "loop": true,
      "bones": {
        "body": {
          "rotation": ["v.lean + math.sin(q.life_time * 60.0) * 1.2", "math.sin(q.modified_distance_moved * 38.17) * 4.0 * v.speed", "v.side"]
        },
        "root": {
          "position": [0, "math.abs(math.sin(q.modified_distance_moved * 38.17)) * 0.7 * v.speed", 0]
        }
      }
    },

    "animation.litius.zombie_furtivo.brazos": {
      "loop": true,
      "bones": {
        "rightArm": {
          "rotation": [
            "-80.0 - v.lean * 0.6 + math.sin(q.modified_distance_moved * 38.17) * 7.0 * v.speed + math.sin(q.life_time * 70.0) * 2.5",
            "-6.0",
            "3.0 + math.cos(q.life_time * 55.0) * 2.5"
          ]
        },
        "leftArm": {
          "rotation": [
            "-80.0 - v.lean * 0.6 - math.sin(q.modified_distance_moved * 38.17) * 7.0 * v.speed - math.sin(q.life_time * 70.0) * 2.5",
            "6.0",
            "-3.0 - math.cos(q.life_time * 55.0) * 2.5"
          ]
        }
      }
    },

