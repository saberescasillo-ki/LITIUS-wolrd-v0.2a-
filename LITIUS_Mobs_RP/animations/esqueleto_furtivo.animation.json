    "animation.litius.esqueleto_furtivo.mirar": {
      "loop": true,
      "bones": {
        "head": {
          "rotation": ["q.target_x_rotation - v.lean", "q.target_y_rotation", "-v.side * 0.5"]
        }
      }
    },

    "animation.litius.esqueleto_furtivo.piernas": {
      "loop": true,
      "bones": {
        "rightLeg": { "rotation": ["v.tcos * 1.15", 0, 0] },
        "leftLeg": { "rotation": ["-v.tcos * 1.15", 0, 0] }
      }
    },

    "animation.litius.esqueleto_furtivo.inclinacion": {
      "loop": true,
      "bones": {
        "body": {
          "rotation": ["v.lean + math.sin(q.life_time * 80.0) * 0.8", 0, "v.side"]
        },
        "root": {
          "position": [0, "math.abs(math.sin(q.modified_distance_moved * 38.17)) * 0.5 * v.speed", 0]
        }
      }
    },

    "animation.litius.esqueleto_furtivo.arco_reposo": {
