{
  "format_version": "1.8.0",
  "animations": {
    "animation.litius.esqueleto_exiliante.mirar": {
      "loop": true,
      "bones": {
        "head": { "rotation": ["q.target_x_rotation - v.lean", "q.target_y_rotation", 0] }
      }
    },

    "animation.litius.esqueleto_exiliante.cuerpo": {
      "loop": true,
      "bones": {
        "body": { "rotation": ["v.lean + math.sin(q.life_time * 70.0) * 0.8", 0, 0] },
        "rightLeg": { "rotation": ["v.tcos * 1.0", 0, 0] },
        "leftLeg": { "rotation": ["-v.tcos * 1.0", 0, 0] }
      }
    },

    "animation.litius.esqueleto_exiliante.reposo": {
      "loop": true,
      "bones": {
        "rightArm": {
          "rotation": [
            "-32.0 + math.sin(q.life_time * 90.0) * 2.0 + math.sin(q.life_time * 900.0) * 0.6",
            "8.0",
            "26.0 + math.cos(q.life_time * 75.0) * 2.0"
          ]
        },
        "leftArm": {
          "rotation": [
            "-32.0 + math.sin(q.life_time * 90.0 + 40.0) * 2.0 + math.sin(q.life_time * 900.0 + 90.0) * 0.6",
            "-8.0",
            "-26.0 - math.cos(q.life_time * 75.0) * 2.0"
          ]
        }
      }
    },

    "animation.litius.esqueleto_exiliante.caminar": {
      "loop": true,
      "bones": {
        "rightArm": { "rotation": ["38.0 + math.sin(q.modified_distance_moved * 38.17) * 2.0 * v.speed", 0, "-14.0"] },
        "leftArm": { "rotation": ["38.0 - math.sin(q.modified_distance_moved * 38.17) * 2.0 * v.speed", 0, "14.0"] }
      }
    },

    "animation.litius.esqueleto_exiliante.bofetada": {
      "animation_length": 0.6,
      "loop": false,
      "bones": {
        "rightArm": {
          "rotation": {
            "0.0":  { "post": [-20, 0, 15], "lerp_mode": "catmullrom" },
            "0.18": { "post": [-75, 70, 85], "lerp_mode": "catmullrom" },
            "0.3":  { "post": [-85, -45, 10], "lerp_mode": "catmullrom" },
            "0.42": { "post": [-70, -75, -5], "lerp_mode": "catmullrom" },
            "0.6":  { "post": [-32, 8, 26], "lerp_mode": "catmullrom" }
          }
        },
        "leftArm": { "rotation": [38, 0, 14] },
        "body": {
          "rotation": {
            "0.0":  { "post": [0, 0, 0], "lerp_mode": "catmullrom" },
            "0.18": { "post": [-4, 25, 0], "lerp_mode": "catmullrom" },
            "0.3":  { "post": [6, -25, 0], "lerp_mode": "catmullrom" },
            "0.42": { "post": [5, -30, 0], "lerp_mode": "catmullrom" },
            "0.6":  { "post": [0, 0, 0], "lerp_mode": "catmullrom" }
          }
        },
        "head": {
          "rotation": {
            "0.0":  { "post": [0, 0, 0], "lerp_mode": "catmullrom" },
            "0.18": { "post": [0, -15, 0], "lerp_mode": "catmullrom" },
            "0.3":  { "post": [0, 15, 0], "lerp_mode": "catmullrom" },
            "0.6":  { "post": [0, 0, 0], "lerp_mode": "catmullrom" }
          }
        }
      }
    },

    "animation.litius.esqueleto_exiliante.invocar": {
      "animation_length": 1.2,
      "loop": "hold_on_last_frame",
      "bones": {
        "rightArm": {
          "rotation": {
            "0.0":  { "post": [-32, 8, 26], "lerp_mode": "catmullrom" },
            "0.35": { "post": [-165, 0, 30], "lerp_mode": "catmullrom" },
            "0.55": { "post": [-170, 0, 25], "lerp_mode": "catmullrom" },
            "0.75": { "post": [-55, 0, 20], "lerp_mode": "catmullrom" },
            "1.0":  { "post": [-50, 0, 22], "lerp_mode": "catmullrom" },
            "1.2":  { "post": [-32, 8, 26], "lerp_mode": "catmullrom" }
          }
        },
        "leftArm": {
          "rotation": {
            "0.0":  { "post": [-32, -8, -26], "lerp_mode": "catmullrom" },
            "0.35": { "post": [-165, 0, -30], "lerp_mode": "catmullrom" },
            "0.55": { "post": [-170, 0, -25], "lerp_mode": "catmullrom" },
            "0.75": { "post": [-55, 0, -20], "lerp_mode": "catmullrom" },
            "1.0":  { "post": [-50, 0, -22], "lerp_mode": "catmullrom" },
            "1.2":  { "post": [-32, -8, -26], "lerp_mode": "catmullrom" }
          }
        },
        "body": {
          "rotation": {
            "0.0":  { "post": [0, 0, 0], "lerp_mode": "catmullrom" },
            "0.35": { "post": [-12, 0, 0], "lerp_mode": "catmullrom" },
            "0.55": { "post": [-14, 0, 0], "lerp_mode": "catmullrom" },
            "0.75": { "post": [15, 0, 0], "lerp_mode": "catmullrom" },
            "1.0":  { "post": [12, 0, 0], "lerp_mode": "catmullrom" },
            "1.2":  { "post": [0, 0, 0], "lerp_mode": "catmullrom" }
          }
        },
        "head": {
          "rotation": {
            "0.0":  { "post": [0, 0, 0], "lerp_mode": "catmullrom" },
            "0.4":  { "post": [-25, 0, 0], "lerp_mode": "catmullrom" },
            "0.75": { "post": [10, 0, 0], "lerp_mode": "catmullrom" },
            "1.2":  { "post": [0, 0, 0], "lerp_mode": "catmullrom" }
          }
        },
        "root": {
          "position": {
            "0.35": [0, 0, 0],
            "0.45": ["math.random(-0.4, 0.4)", 0, "math.random(-0.4, 0.4)"],
            "0.55": ["math.random(-0.4, 0.4)", 0, "math.random(-0.4, 0.4)"],
            "0.65": [0, 0, 0]
          }
        }
      },
      "particle_effects": {
        "0.75": { "effect": "tierra" }
      }
    }
  }
}
