{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "minecraft:enderman",
      "min_engine_version": "1.8.0",
      "materials": {
        "default": "enderman",
        "invisible": "enderman_invisible",
        "cristal": "entity_alphatest"
      },
      "textures": {
        "default": "textures/entity/enderman/enderman",
        "mejorado": "textures/entity/litius/enderman_mejorado",
        "cristal": "textures/entity/litius/cristal_ender"
      },
      "geometry": {
        "default": "geometry.enderman.v1.8",
        "cristal": "geometry.litius.cristal_ender"
      },
      "scripts": {
        "pre_animation": [
          "variable.tcos0 = (Math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed / variable.gliding_speed_value) * 28.65;"
        ],
        "animate": [
          "look_at_target",
          "move",
          "attack",
          "bob",
          "base_pose",
          "carrying",
          "scary_face"
        ]
      },
      "animations": {
        "look_at_target_default": "animation.humanoid.look_at_target.default",
        "look_at_target_gliding": "animation.humanoid.look_at_target.gliding",
        "look_at_target_swimming": "animation.humanoid.look_at_target.swimming",
        "move": "controller.animation.humanoid.move",
        "attack.rotations": "animation.humanoid.attack.rotations",
        "bob": "controller.animation.humanoid.bob",
        "base_pose": "controller.animation.enderman.base_pose",
        "arms_legs": "animation.enderman.arms_legs",
        "carrying": "controller.animation.enderman.carrying",
        "scary_face": "controller.animation.enderman.scary_face",
        "look_at_target": "controller.animation.humanoid.look_at_target",
        "attack": "controller.animation.humanoid.attack"
      },
      "render_controllers": [
        "controller.render.litius.enderman",
        {
          "controller.render.litius.cristal": "query.property('litius:mutacion') == 1 && !query.is_invisible"
        }
      ],
      "spawn_egg": {
        "texture": "spawn_egg_enderman"
      }
    }
  }
}
